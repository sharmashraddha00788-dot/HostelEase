              "mode": "raw",
              "raw": "{\n  \"roomNumber\": \"106\",\n  \"block\": \"A\",\n  \"floor\": 1,\n  \"capacity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms"]
            }
          }
        },
        {
          "name": "4. Update Room Maintenance (Warden & Admin)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"maintenance\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rooms/673d1234567890abcdef1234",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms", "673d1234567890abcdef1234"]
            }
          }
        },
        {
          "name": "5. Delete Empty Room (Admin Only)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/rooms/673d1234567890abcdef1234",
              "host": ["{{baseUrl}}"],
              "path": ["api", "rooms", "673d1234567890abcdef1234"]
            }
          }
        }
      ]
    },
    {
      "name": "Allocations",
      "item": [
        {
          "name": "1. Student Requests Room",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": \"673d1234567890abcdef1234\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/allocations/request",
              "host": ["{{baseUrl}}"],
              "path": ["api", "allocations", "request"]
            }
          }
        },
        {
          "name": "2. Student Checks My Allocation Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/allocations/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "allocations", "my"]
            }
          }
        },
        {
          "name": "3. Student Vacates Room",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/allocations/vacate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "allocations", "vacate"]
