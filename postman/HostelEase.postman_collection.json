          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wardenNotes\": \"Documents verified. Room allocated for current semester.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/allocations/673d1234567890abcdef1234/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "allocations", "673d1234567890abcdef1234", "approve"]
            }
          }
        },
        {
          "name": "6. Warden Rejects Request",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionReason\": \"Room reserved for final year students. Please select Block B.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/allocations/673d1234567890abcdef1234/reject",
              "host": ["{{baseUrl}}"],
              "path": ["api", "allocations", "673d1234567890abcdef1234", "reject"]
            }
          }
        },
        {
          "name": "7. Admin/Warden Force Vacates Student",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/allocations/673d1234567890abcdef1234/admin-vacate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "allocations", "673d1234567890abcdef1234", "admin-vacate"]
            }
          }
        }
      ]
